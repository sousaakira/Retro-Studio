pkgbase = retro-studio-bin
	pkgdesc = Editor de jogos de Mega Drive (Genesis) em cenas, com SGDK e BlastEm
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/sousaakira/Retro-Studio
	arch = x86_64
	license = MIT
	license = GPL-3.0-or-later
	license = GPL-2.0-only WITH Classpath-exception-2.0
	depends = glibc
	depends = libx11
	depends = libxcursor
	depends = libxext
	depends = libxi
	depends = libxinerama
	depends = libxrandr
	depends = libxrender
	depends = libglvnd
	depends = fontconfig
	optdepends = wayland: rodar direto no Wayland
	optdepends = libpulse: som pelo PulseAudio/PipeWire
	optdepends = alsa-lib: som pelo ALSA
	optdepends = sdl2: BlastEm com a interface nova (sem ela, o editor abre o BlastEm oficial)
	optdepends = glew: BlastEm com a interface nova (sem ela, o editor abre o BlastEm oficial)
	provides = retro-studio
	conflicts = retro-studio
