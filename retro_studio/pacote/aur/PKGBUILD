# Maintainer: Akira Sousa <sousa.akira@gmail.com>
#
# Retro Studio, editor de jogos de Mega Drive. Pacote binário: usa o pacote Linux da Release do GitHub
# (editor, Java mínimo e make) e acrescenta o kit SGDK/MarsDev e o BlastEm do servidor do Retro Studio,
# tudo em /opt/retro-studio. O editor acha o kit e o emulador ali quando não há outros em ~/.retrostudio.
# Para atualizar: ./atualizar.sh <versão> (veja LEIA-ME.md).

pkgname=retro-studio-bin
pkgver=1.0.1
pkgrel=1
pkgdesc="Editor de jogos de Mega Drive (Genesis) em cenas, com SGDK e BlastEm"
arch=('x86_64')
url="https://github.com/sousaakira/Retro-Studio"
license=('MIT' 'GPL-3.0-or-later' 'GPL-2.0-only WITH Classpath-exception-2.0')
# O editor carrega as bibliotecas de janela, vídeo e som quando abre (dlopen).
depends=('glibc' 'libx11' 'libxcursor' 'libxext' 'libxi' 'libxinerama' 'libxrandr' 'libxrender'
	'libglvnd' 'fontconfig')
optdepends=('wayland: rodar direto no Wayland'
	'libpulse: som pelo PulseAudio/PipeWire'
	'alsa-lib: som pelo ALSA'
	'sdl2: BlastEm com a interface nova (sem ela, o editor abre o BlastEm oficial)'
	'glew: BlastEm com a interface nova (sem ela, o editor abre o BlastEm oficial)')
provides=('retro-studio')
conflicts=('retro-studio')
options=('!strip' '!debug')
_kit_url="https://api.retrostudio.dev/packages"
source=("https://github.com/sousaakira/Retro-Studio/releases/download/v${pkgver}/retro-studio-${pkgver}-linux-x86_64.tar.gz"
	"marsdev-linux-x64-${pkgver}.zip::${_kit_url}/marsdev-linux-x64.zip"
	"blastem-linux-x64-${pkgver}.zip::${_kit_url}/blastem-linux-x64.zip"
	"retro-studio.desktop")
# Os zips do kit e do BlastEm só se descompactam no package(), em pastas próprias.
noextract=("marsdev-linux-x64-${pkgver}.zip" "blastem-linux-x64-${pkgver}.zip")
sha256sums=('SKIP'
	'4e86a7b438a3ad5be7a37cf5d325b7f87130171c4a00f0faecfbaa5c63913d1a'
	'3c13a524507c10ce50ff17804edce01491339c1c799a085a4537111f4e222205'
	'SKIP')

package() {
	local origem="$srcdir/retro-studio-${pkgver}-linux-x86_64"
	local app="$pkgdir/opt/retro-studio"

	install -d "$app"
	cp -a "$origem/bin" "$origem/kit" "$origem/jogo_padrao" "$origem/teste_kit" "$origem/docs" "$origem/licencas" "$app/"
	install -Dm644 "$origem/LEIA-ME.txt" "$app/LEIA-ME.txt"

	# Kit SGDK/MarsDev (só o m68k-elf) e BlastEm, onde o editor procura quando não há em ~/.retrostudio.
	install -d "$app/kit/marsdev/mars" "$app/kit/blastem"
	bsdtar -xf "$srcdir/marsdev-linux-x64-${pkgver}.zip" -C "$app/kit/marsdev/mars"
	bsdtar -xf "$srcdir/blastem-linux-x64-${pkgver}.zip" -C "$app/kit/blastem"
	rm -f "$app/kit/blastem/debug.log" "$app/kit/marsdev/mars/m68k-elf/out.lst"
	# O Makefile dos projetos põe a pasta bin do kit na frente do PATH: com o java ali, o make também
	# funciona num terminal, fora do editor (igual ao instalar.sh).
	ln -s /opt/retro-studio/kit/jre/bin/java "$app/kit/marsdev/mars/m68k-elf/bin/java"

	# Sem o instalar.sh: quem instala e conserta é o pacman. O editor lê este aviso no lugar do Reparar.
	printf '%s\n' "O Retro Studio foi instalado pelo pacote ${pkgname} (AUR). Para consertar o kit ou o emulador em /opt/retro-studio, reinstale o pacote (por exemplo: yay -S ${pkgname} --rebuild), ou instale um kit próprio em ~/.retrostudio." \
		>"$app/pacote-do-sistema.txt"

	install -d "$pkgdir/usr/bin"
	ln -s /opt/retro-studio/bin/retro-studio "$pkgdir/usr/bin/retro-studio"
	install -Dm644 "$srcdir/retro-studio.desktop" "$pkgdir/usr/share/applications/retro-studio.desktop"
	install -Dm644 "$origem/retro-studio.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/retro-studio.png"
	install -d "$pkgdir/usr/share/licenses/$pkgname"
	cp -a "$origem/licencas/." "$pkgdir/usr/share/licenses/$pkgname/"
	[ -f "$app/kit/blastem/COPYING" ] && install -Dm644 "$app/kit/blastem/COPYING" "$pkgdir/usr/share/licenses/$pkgname/blastem-COPYING"
	return 0
}
