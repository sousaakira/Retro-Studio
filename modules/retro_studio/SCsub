#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_retro_studio = env_modules.Clone()
env_retro_studio.add_source_files(env.modules_sources, "*.cpp")
env_retro_studio.add_source_files(env.modules_sources, "audio/*.cpp")
env_retro_studio.add_source_files(env.modules_sources, "editor/*.cpp")
env_retro_studio.add_source_files(env.modules_sources, "scene/*.cpp")

# O guia do Retro Studio vai dentro do editor: a IA o lê pela ferramenta "guide" do servidor MCP.
def _embed_guide():
    import os
    source = os.path.join(Dir("#").abspath, "retro_studio", "docs", "GUIA.md")
    target = os.path.join(Dir(".").srcnode().abspath, "editor", "retro_guia.gen.h")
    with open(source, "rb") as f:
        data = f.read()
    body = "// Gerado pelo SCsub a partir de retro_studio/docs/GUIA.md.\n#pragma once\nstatic const unsigned char RETRO_GUIA[] = {" + ",".join(str(b) for b in data) + ",0};\n"
    old = open(target).read() if os.path.exists(target) else ""
    if old != body:
        with open(target, "w") as f:
            f.write(body)


_embed_guide()


# A biblioteca dos atores (runtime/*.h e *.c) vai dentro do editor: o build a grava em src/gerado/.
def _embed_runtime():
    import os
    folder = os.path.join(Dir(".").srcnode().abspath, "runtime")
    target = os.path.join(Dir(".").srcnode().abspath, "editor", "retro_runtime.gen.h")
    body = "// Gerado pelo SCsub a partir de modules/retro_studio/runtime/.\n#pragma once\nstruct RetroRuntimeFile { const char *name; const unsigned char *data; };\n"
    names = sorted(n for n in os.listdir(folder) if n.endswith((".h", ".c")))
    for i, name in enumerate(names):
        with open(os.path.join(folder, name), "rb") as f:
            data = f.read()
        body += "static const unsigned char RETRO_RUNTIME_%d[] = {" % i + ",".join(str(b) for b in data) + ",0};\n"
    body += "static const RetroRuntimeFile RETRO_RUNTIME_FILES[] = {" + "".join('{"%s", RETRO_RUNTIME_%d},' % (n, i) for i, n in enumerate(names)) + "{nullptr, nullptr}};\n"
    old = open(target).read() if os.path.exists(target) else ""
    if old != body:
        with open(target, "w") as f:
            f.write(body)


_embed_runtime()
