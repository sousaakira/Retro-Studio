{
  "mapExport": {
    "script": "tools/export-map.py",
    "sourceMaps": [
      "maps/map.tmx"
    ],
    "outputProtocol": "retro-studio-map-outputs-v1",
    "runtimeGeometry": true,
    "inputPaths": [
      "maps",
      "res",
      "charsets"
    ]
  },
  "retroStudio": {
    "contractVersion": 1,
    "target": {
      "platform": "megadrive",
      "sdk": "sgdk",
      "videoMode": "H40",
      "region": "auto"
    },
    "adapter": {
      "id": "sgdk-map-v1",
      "version": 1,
      "capabilities": [
        "map.bg",
        "map.fg",
        "map.background",
        "map.priority",
        "map.collision",
        "object.visual",
        "object.animation"
      ]
    },
    "modules": []
  }
}
